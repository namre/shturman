# Скопируйте в .env командой ./ops/init-env.sh — она спросит значения без вывода на экран.
# Пометка [secret] — значение вводится скрыто. [value] — обычное значение. [auto] — генерируется.
# В этом файле значений нет и быть не должно.

# [secret] Токен управляющего бота от @BotFather (этот же бот подключается в бизнес-режиме)
TELEGRAM_BOT_TOKEN=

# [value] Ваш числовой Telegram ID — только этот пользователь может управлять ассистентом
TELEGRAM_ALLOWED_USERS=

# [secret] Ключ OpenAI API (platform.openai.com). Нужен для модели; для эмбеддингов и голосовых — если не выбран локальный режим
OPENAI_API_KEY=

# [value] api_id вашего собственного приложения Telegram (my.telegram.org) — для дополнительного аккаунта
TELEGRAM_API_ID=

# [secret] api_hash того же приложения
TELEGRAM_API_HASH=

# [auto] Пароль базы данных
POSTGRES_PASSWORD=

# [value] Исходящий прокси, если с сервера нет прямого доступа к Telegram или к провайдеру модели (пусто = напрямую)
EGRESS_PROXY_URL=

# [value] Эмбеддинги: local (на сервере, текст не уходит наружу) или openai
EMBEDDINGS_MODE=local

# [value] Распознавание голосовых: local, openai или off
STT_MODE=local

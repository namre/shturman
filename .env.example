# Служебные значения генерирует ./ops/init-env.sh --auto. Остальное зависит от режима установки:
#   режим с Hermes (по умолчанию) — токены и ключи владелец вводит в веб-интерфейсе (docs/setup.md),
#     а этот файл целиком нужен только для запасного пути без веб-интерфейса;
#   режим без Hermes (standalone, docs/standalone.md) — веб-интерфейса нет: токен бота согласований
#     и ключ модели владелец вводит сам командой ./ops/init-env.sh, скрытым вводом.
# Пометка [secret] — значение вводится скрыто. [value] — обычное значение. [auto] — генерируется.
# Приписка после двоеточия ([value:hermes], [secret:hermes]) — вопрос задаётся только в этом режиме.
# В этом файле значений нет и быть не должно.
#
# Режим установки хранится в .env строкой SHTURMAN_MODE=hermes или SHTURMAN_MODE=standalone.
# Её записывает ./ops/init-env.sh (ключ --mode, без него — hermes), меняет ./ops/mode.sh.
# Вместе с ней скрипты ведут строку COMPOSE_PROFILES. Обе строки не секретные.

# [value:hermes] Адрес, по которому вы открываете ассистента в браузере, например https://assistant.example.com (пусто = только с самого сервера, без входа)
SHTURMAN_PUBLIC_URL=

# [secret:hermes] Токен бота-ассистента от @BotFather — с ним вы разговариваете. В бизнес-режиме Telegram его не подключают: бизнес-режим — у бота согласований (ниже)
TELEGRAM_BOT_TOKEN=

# [value:hermes] Ваш числовой Telegram ID — только этот пользователь может управлять ассистентом
TELEGRAM_ALLOWED_USERS=

# [secret:hermes] Ключ OpenAI API (platform.openai.com). Модель для Hermes; можно пропустить, если в Hermes будет вход по подписке. Также нужен для эмбеддингов и голосовых, если они не локальные
OPENAI_API_KEY=

# [secret] Токен бота согласований от @BotFather — отдельный бот, которым владеет сервис переписки: карточки с кнопками, а при желании и бизнес-режим. Без Hermes это единственный бот; с Hermes — по желанию, и это НЕ управляющий бот Hermes
SHTURMAN_BOT_TOKEN=

# [secret] Ключ провайдера модели для сервиса переписки (API, совместимый с OpenAI): им разбираются обязательства и страницы памяти. Без Hermes нужен обязательно; с Hermes — по желанию
SHTURMAN_LLM_API_KEY=

# [value] Имя модели у этого провайдера — точно так, как оно названо в его списке моделей (без ключа и имени модели сервис к модели не обращается)
SHTURMAN_LLM_MODEL=

# [value] Адрес API провайдера модели; пусто = https://api.openai.com/v1, для OpenRouter — https://openrouter.ai/api/v1
SHTURMAN_LLM_BASE_URL=

# [value] api_id вашего собственного приложения Telegram (my.telegram.org) — для чтения аккаунтов через сессию; не нужно, если используете только бота и экспорт
TELEGRAM_API_ID=

# [secret] api_hash того же приложения
TELEGRAM_API_HASH=

# [auto] Пароль базы данных
POSTGRES_PASSWORD=

# [auto] Токен внутреннего API сервиса переписки (им пользуются плагин «Штурмана» в Hermes и команда shturman call)
SHTURMAN_API_TOKEN=

# [auto] Токен архива, только чтение: для агента Hermes, а без Hermes — для вашего Codex CLI или Claude Code (./ops/connect.sh)
SHTURMAN_MCP_TOKEN=

# [value] Часовой пояс владельца: по нему считаются сроки и время ночной обработки
SHTURMAN_TIMEZONE=Europe/Moscow

# [value] Исходящий прокси, если с сервера нет прямого доступа к Telegram или к провайдеру модели (пусто = напрямую)
EGRESS_PROXY_URL=

# [value:hermes] Версия официального образа Hermes; пусто = проверенная версия из compose.yaml
HERMES_VERSION=

# Поиск по смыслу (локальные эмбеддинги) включается командой ./ops/embeddings.sh on [--model …]:
# она сама записывает сюда COMPOSE_PROFILES, SHTURMAN_EMBEDDINGS_URL, SHTURMAN_EMBEDDINGS_MODEL
# и SHTURMAN_EMBEDDINGS_MODEL_DIR. Моделей две: e5-small (по умолчанию, около 1,2 ГБ памяти)
# и user2-small (0,2–0,7 ГБ). Смена модели — пересчёт всех векторов (docs/search.md).

# Защита от внедрённых инструкций во входящих сообщениях включается командой ./ops/guard.sh on:
# она сама записывает сюда COMPOSE_PROFILES, SHTURMAN_GUARD и SHTURMAN_GUARD_URL. Нужно около 0,6 ГБ
# памяти. Что защита ловит и чего не ловит — docs/guard.md.

# [value:hermes] Распознавание голосовых: local, openai или off
STT_MODE=local

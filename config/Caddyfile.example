# Пример настройки Caddy для экземпляра «Штурмана» (режим с Hermes). Проверено с Caddy 2.10.2.
# Замените assistant.example.com своим именем (в обоих блоках), а /opt/shturman — путём
# к репозиторию на сервере.
#
# Блоков сайта ДВА — на одном имени, но на разных портах:
#   assistant.example.com        (порт 443)  — дашборд Hermes и статические страницы входа «Штурмана»;
#   assistant.example.com:8443               — страница настройки переписки, которую отдаёт сам
#                                              сервис переписки, мимо Hermes, за собственным входом.
#
# Почему у страницы настройки другой порт. Ассистент в Hermes может ставить расширения дашборда,
# то есть исполнять свой JavaScript на адресе дашборда. Браузер считает «своими» друг для друга
# страницы, у которых совпадают схема, имя и порт. На общем адресе такой скрипт действовал бы на
# странице настройки от имени вошедшего владельца (включил бы чтение всех чатов), а service
# worker'ом перехватывал бы то, что владелец вводит. Другой порт — уже другой адрес для браузера:
# ни читать страницу, ни нажимать на ней, ни перехватывать её запросы скрипт с адреса дашборда
# не может. Поэтому:
#   * в блоке дашборда пути /shturman-setup* нет вовсе — на него стоит явный отказ;
#   * страница настройки живёт в своём блоке, и из порта сервиса (8765) наружу выходит один её префикс.
# Не объединяйте блоки и не переносите /shturman-setup/* в блок дашборда: сервис переписки на общем
# адресе страницу всё равно не отдаст, а ./ops/doctor.sh покажет FAIL setup-isolation.
#
# Владельцу порт 8443 ни знать, ни набирать не нужно: он переходит по кнопке в мастере и по ссылке
# из ./ops/setup-link.sh. Адреса записывают ./ops/set-public-url.sh (дашборд; он же записывает адрес
# страницы по умолчанию — то же имя, порт 8443) и ./ops/set-setup-url.sh (другой порт или имя).
#
# Что нужно кроме этого файла:
#   * порт 8443 открыть в firewall сервера и в правилах хостинга, если они есть, — это стоп-точка
#     (sudo), как и сама правка прокси;
#   * сертификат: Caddy получает его сам, один на имя, и отдаёт на обоих портах. Проверка владения
#     именем идёт через порты 80 и 443, поэтому для порта 8443 ничего дополнительного не требуется;
#   * если перед сервером стоит Cloudflare в режиме прокси («оранжевое облако»): HTTPS на порту 8443
#     он пропускает — это один из его портов по умолчанию (443, 2053, 2083, 2087, 2096, 8443;
#     документация Cloudflare «Network ports», сверено 2026-10-07). Кеш на этом порту выключен —
#     странице он и не нужен. На платных тарифах есть правило WAF, которое блокирует нестандартные
#     порты; по умолчанию оно выключено — если включали, для 8443 нужно исключение. Cloudflare Access
#     номер порта из защищаемого адреса убирает: ставить его перед страницей настройки на порту
#     нельзя — берите отдельное имя (ниже). Другой порт вместо 8443 выбирайте из того же перечня;
#   * если порт открыть нельзя вовсе — отдельное имя на обычном порту, см. конец файла.
#
# Заголовок Host не подменяется ни в одном блоке: Hermes сверяет его с SHTURMAN_PUBLIC_URL, сервис
# переписки — с SHTURMAN_SETUP_URL (имя вместе с портом).
#
# Журнал запросов здесь не включён намеренно. Если включаете — не пишите в него строку запроса
# для /auth/callback: при входе в ней один раз проходит одноразовый код или значение ссылки
# активации. Для блока страницы настройки журнал не включайте вовсе.
#
# В режиме без Hermes («только архив и согласования») прокси не ставится: страница настройки
# переписки открывается с самого сервера или через туннель SSH.

assistant.example.com {
	encode gzip

	# Страницы настройки переписки на этом адресе нет и быть не должно (см. шапку). Отказ отвечает
	# сам прокси: запрос не уходит ни сервису переписки, ни Hermes. Шаблон намеренно широкий: всё,
	# что после разбора пути начинается с /shturman-setup, в любом регистре и в любой записи
	# («//», «%73», «x/../»).
	@no_setup_page path /shturman-setup*
	handle @no_setup_page {
		respond 404
	}

	handle_path /shturman-auth/* {
		root * /opt/shturman/plugins/shturman/public
		header {
			Cache-Control "no-store"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		}
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:9119
	}
}

# Страница настройки переписки — то же имя, другой порт. Наружу отсюда выходит только префикс
# /shturman-setup/ сервиса переписки (порт 8765). Другие его пути отдавать нельзя: /api/* — внутренний
# API, /mcp — архив переписки. Не заменяйте шаблон более широким и не добавляйте сюда второй путь
# на порт 8765. Дашборда Hermes (порт 9119) в этом блоке нет.
assistant.example.com:8443 {
	header Strict-Transport-Security "max-age=31536000"

	# Выгрузка Telegram Desktop загружается на этой странице одним запросом; сервис принимает до
	# 2 ГиБ. Своего предела на тело запроса у Caddy по умолчанию нет, тело он передаёт потоком,
	# не складывая в память, и чтение тела по времени не ограничивает — долгая загрузка не рвётся.
	# Здесь предел задан явно, чуть выше предела сервиса, чтобы лишнее отсекалось ещё на входе.
	request_body {
		max_size 2200MB
	}

	# Сервису уходят только запросы, у которых путь — в том виде, в каком он пришёл, до любых
	# преобразований — начинается ровно с /shturman-setup/ и состоит из простых частей: латинские
	# буквы, цифры, «_», «-» и точка внутри имени. Ни «..», ни «//», ни «%», ни «\», ни «;», ни
	# префикс заглавными буквами до порта 8765 не доходят: на них отвечает отказом сам прокси.
	# Строка запроса после «?» не ограничивается. Сервис проверяет путь ещё раз у себя.
	# Путь уходит сервису как есть, вместе с префиксом /shturman-setup/ (handle, не handle_path).
	@setup_page expression `{http.request.orig_uri}.matches("^/shturman-setup/([A-Za-z0-9_-]+([.][A-Za-z0-9_-]+)*/?)*([?].*)?$")`
	handle @setup_page {
		reverse_proxy 127.0.0.1:8765
	}

	# Адрес без пути и адрес без косой черты на конце — на ту же страницу.
	@bare path / /shturman-setup
	handle @bare {
		redir * /shturman-setup/
	}

	# Всё остальное — отказ, который даёт сам прокси: до сервиса переписки запрос не доходит.
	handle {
		respond 404
	}
}

# Вариант с отдельным именем — если порт 8443 открыть нельзя или перед страницей нужен внешний
# единый вход. Заведите второе имя, направленное на этот же сервер (запись DNS делает владелец),
# замените заголовок второго блока на него:
#     setup.example.com {
# и запишите адрес: ./ops/set-setup-url.sh https://setup.example.com
# Содержимое блока то же. Сертификат для второго имени Caddy получит сам. Блок дашборда и отказ
# на /shturman-setup* в нём остаются как есть.

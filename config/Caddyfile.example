# Пример настройки Caddy для экземпляра «Штурмана» (режим с Hermes).
# Замените assistant.example.com своим адресом и /opt/shturman — путём к репозиторию на сервере.
#
# Наружу видны три вещи:
#   /shturman-auth/*   — статические страницы входа (каталог plugins/shturman/public, данных в них нет);
#   /shturman-setup/*  — страница настройки переписки: её отдаёт сам сервис переписки, мимо Hermes,
#                        за собственным входом (одноразовая ссылка из ./ops/setup-link.sh, потом код
#                        от бота согласований);
#   всё остальное      — дашборд Hermes, который сам требует входа.
#
# Заголовок Host не подменяется: Hermes сверяет его с адресом из SHTURMAN_PUBLIC_URL, сервис
# переписки — с тем же адресом (он получает его как SHTURMAN_SETUP_ORIGIN).
#
# Журнал запросов здесь не включён намеренно. Если включаете — не пишите в него строку запроса
# для /auth/callback: при входе в ней один раз проходит одноразовый код или значение ссылки активации.
#
# В режиме без Hermes («только архив и согласования») прокси не ставится вовсе: страница настройки
# переписки открывается с самого сервера или через туннель SSH.

assistant.example.com {
	encode gzip

	handle_path /shturman-auth/* {
		root * /opt/shturman/plugins/shturman/public
		header {
			Cache-Control "no-store"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		}
		file_server
	}

	# Страница настройки переписки сервиса. Именно handle, а не handle_path: путь уходит сервису
	# как есть, вместе с префиксом /shturman-setup/.
	# Другие пути сервиса наружу отдавать нельзя: /api/* — его внутренний API, /mcp — архив
	# переписки. Не заменяйте шаблон на более широкий и не добавляйте сюда второй путь на порт 8765.
	handle /shturman-setup/* {
		reverse_proxy 127.0.0.1:8765
	}
	# Адрес без косой черты на конце — на ту же страницу.
	redir /shturman-setup /shturman-setup/

	handle {
		reverse_proxy 127.0.0.1:9119
	}
}

# Настройка frps посредника «Штурмана» (docs/relay.md). Проверено с frp 0.71.0.
# relay/install.sh кладёт её в /etc/frp/frps.toml, подставив имя зоны посредника. Секретов в файле
# нет: общий токен frps приходит из /etc/frp/token.env (EnvironmentFile службы), сертификат и ключ
# TLS — через LoadCredential службы (relay/systemd/frps.service). Значения из окружения frp
# подставляет при чтении файла (шаблон Go, .Envs.ИМЯ в двойных фигурных скобках). Весь файл —
# шаблон, комментарии тоже: двойных фигурных скобок в комментариях быть не должно.

# Исходящие соединения экземпляров (frpc) — порт 7000, только поверх TLS.
bindAddr = "0.0.0.0"
bindPort = 7000
# Браузеры: 443 — пересылка по имени сайта (SNI) без расшифровки, 80 — по заголовку Host (нужен
# только для перенаправления на https и проверки Let's Encrypt http-01).
vhostHTTPSPort = 443
vhostHTTPPort = 80
# Имена экземпляров — только внутри зоны, полем subdomain у frpc: <имя>.<зона> и setup-<имя>.<зона>.
subDomainHost = "@DOMAIN@"

# Общий токен у всех экземпляров один и границей доверия не служит: кто какой экземпляр и какие
# имена ему можно занять, решает служба relayd по ключу экземпляра (плагин ниже).
auth.method = "token"
auth.token = "{{ .Envs.FRP_AUTH_TOKEN }}"

# Только TLS. Сертификат frps постоянный (создаёт relay/install.sh, срок 10 лет); экземпляр получает
# его при подключении и проверяет им посредника — без этого frpc принимает любой сертификат, и
# перехвативший соединение узнал бы ключ экземпляра.
transport.tls.force = true
transport.tls.certFile = "{{ .Envs.CREDENTIALS_DIRECTORY }}/frps.crt"
transport.tls.keyFile = "{{ .Envs.CREDENTIALS_DIRECTORY }}/frps.key"
# Запас рабочих соединений на экземпляр: frpc больше и не просит, ограничение — на всякий случай.
transport.maxPoolCount = 5

# Панели frps (webServer) нет: управление — relayctl на самом посреднике.
log.to = "console"
# Только предупреждения и ошибки: в строках уровня info frps пишет номер подключения (run_id) каждого
# экземпляра, а номер вместе с общим токеном позволил бы открывать рабочие соединения за чужой
# экземпляр (docs/relay.md, риск 8). В предупреждениях номер остаётся только у неудачных рабочих
# соединений. Журнал systemd читают root и группа adm — посторонних в ней быть не должно.
log.level = "warn"

# Серверный плагин — служба relayd на этом же сервере (relay/relayd.py). Без её ответа frps
# отказывает: служба не отвечает — новые подключения и пересылки не принимаются.
[[httpPlugins]]
name = "shturman-relayd"
addr = "127.0.0.1:7400"
path = "/frps/handler"
ops = ["Login", "NewProxy", "NewWorkConn"]

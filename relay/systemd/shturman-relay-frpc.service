# Служебный frpc посредника: имя relay.<зона> → локальный Caddy посредника (relay/frpc-operator.toml).
# Ставит relay/install.sh. Общий токен и ключ служебного экземпляра — EnvironmentFile, читает только root.
[Unit]
Description=frpc посредника «Штурмана» (relay.<зона> → Caddy посредника)
After=frps.service shturman-relay-caddy.service
Wants=frps.service shturman-relay-caddy.service

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/frp/token.env
EnvironmentFile=/etc/shturman-relay/operator.env
ExecStart=/opt/shturman-relay/bin/frpc -c /etc/shturman-relay/frpc.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
